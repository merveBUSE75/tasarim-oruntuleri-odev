name: C++ CI Build Test

on:
  push:
    branches: [ "main", "phase-1", "phase-2", "phase-3" ]
  pull_request:
    branches: [ "main" ]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - name: Depoyu Kopyala
      uses: actions/checkout@v4

    - name: C++ Derleme Testi
      run: |
        g++ -std=c++11 src/main.cpp -o MiniOyunMotoru
        ./MiniOyunMotoru
